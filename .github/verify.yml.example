name: Verificar projeto
on: [push, pull_request, workflow_dispatch]
permissions:
  contents: read
jobs:
  verificacao:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Instalar dependências de inferência
        run: python -m pip install -r requirements-inference.txt
      - name: Executar testes
        run: python -m unittest discover -s tests -v
      - name: Verificar demonstração
        run: python verify.py
      - name: Reproduzir o treino em execução manual
        if: github.event_name == 'workflow_dispatch'
        run: |
          python -m pip install -r requirements.txt
          python train.py --out .local/ci-train
